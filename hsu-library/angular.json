{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "hsu-library": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/hsu-library",
      "sourceRoot": "projects/hsu-library/src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/hsu-library/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/hsu-library/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/hsu-library/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/hsu-library/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "projects/hsu-library/.storybook",
            "browserTarget": "hsu-library:build",
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "projects/hsu-library"
            ],
            "styles": [
              "projects/hsu-library/src/lib/styles.scss"
            ],
            "port": 6006,
            "host": "0.0.0.0"
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/hsu-library/.storybook",
            "browserTarget": "hsu-library:build",
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "projects/hsu-library"
            ],
            "styles": [
              "projects/hsu-library/src/lib/styles.scss"
            ],
            "outputDir": "storybook-static"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
